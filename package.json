{
  "name": "commitology-data",
  "private": true,
  "type": "module",
  "description": "Data processing scripts for commitology",
  "homepage": "https://github.com/algolia/commitology-data",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "yarn@4.10.3",
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "aberlaas": "2.27.0",
    "algolia-indexing": "2.0.0",
    "bottleneck": "2.19.5",
    "chroma-js": "3.2.0",
    "firost": "5.7.0",
    "gilmore": "1.2.0",
    "golgoth": "3.1.0",
    "keyleth": "0.3.0",
    "remark-gemoji": "8.0.0",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  },
  "scripts": {
    "algolia:ask": "node ./scripts/algolia/ask.js",
    "algolia:push": "node ./scripts/algolia/push.js",
    "algolia:teach": "node ./scripts/algolia/teach.js",
    "ci": "./scripts/ci",
    "compress": "./scripts/compress",
    "github:ratelimit": "./scripts/github-ratelimit",
    "input:authors": "node ./scripts/input/authors.js",
    "input:comments:issues": "node ./scripts/input/comments-issues.js",
    "input:comments:pulls": "node ./scripts/input/comments-pulls.js",
    "input:commits": "node ./scripts/input/commits.js",
    "input:issues": "node ./scripts/input/issues.js",
    "input:pulls": "node ./scripts/input/pulls.js",
    "input:reviews": "node ./scripts/input/reviews.js",
    "input:sentiment:issues": "node ./scripts/input/sentiment-issues.js",
    "input:users": "node ./scripts/input/users.js",
    "lint": "./scripts/lint",
    "lint:fix": "./scripts/lint-fix",
    "output:all": "./scripts/output/all",
    "output:comments": "node ./scripts/output/comments.js",
    "output:commits": "node ./scripts/output/commits.js",
    "output:issues": "node ./scripts/output/issues.js",
    "output:pulls": "node ./scripts/output/pulls.js",
    "output:users": "node ./scripts/output/users.js",
    "release": "./scripts/release",
    "test": "./scripts/test",
    "test:watch": "./scripts/test-watch"
  }
}
