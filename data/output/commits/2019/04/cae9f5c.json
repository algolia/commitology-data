    "\r",
    "* feedback: curly styles\r",
    "\r",
    "* feat(insights): compute insights data in connectHits [PART-1]  (algolia/react-instantsearch#2216)\r",
    "\r",
    "* feat(insights): compute insights data in connectHits\r",
    "\r",
    "adds __positions and __queryID to every hit\r",
    "\r",
    "* feedback: move helper methods to utils.js\r",
    "\r",
    "* feedback: rename hits to hitsWithPositions and hitsWithPositionsAndQueryID\r",
    "\r",
    "* feat(insights): add connectInsights connector [PART-2]  (algolia/react-instantsearch#2217)\r",
    "\r",
    "* feat(insights): add connectInsights connector\r",
    "\r",
    "This connector is to be used on the hitComponent provided to <Hits /> and <InfiniteHits />\r",
    "\r",
    "**Usage**:\r",
    "\r",
    "```tsx\r",
    "// window.aa is the insightsClient\r",
    "\r",
    "const Product = ({ hit, insights }) => <span />\r",
    "const ProductWithInsights = connectInsights(aa)(Product)\r",
    "\r",
    "<Hits hitComponent={ProductWithInsights} />\r",
    "```\r",
    "\r",
    "```tsx\r",
    "const Product = ({ hit, insights }) => (\r",
    "   <>\r",
    "   \t<a href={`/product/${hit.objectID}/?queryID=${hit.__queryID}`}>\r",
    "\t \t{hit.name}\r",
    "\t</a>\r",
    "\r",
    "        <button onClick={() => insights(\"clickedObjectIDsAfterSearch\",\r",
    "\t{\"eventName\": \"Add to cart\"})}>\r",
    "\t\tAdd to Cart\r",
    "\t</button>\r",
    "\r",
    "        <button onClick={() => insights(\"convertedObjectIDsAfterSearch\",\r",
    "\t{\"eventName\": \"Add to cart\"})}>\r",
    "\t\tAdd to Cart\r",
    "\t</button>\r",
    "   </>\r",
    ")\r",
    "\r",
    "```\r",
    "\r",
    "This sends to the API\r",
    "```js\r",
    "aa('clickedObjectIDsAfterSearch', {\r",
    "\teventName: \"Add to cart\",\r",
    "\tindex: \"...\", // infered\r",
    "\tqueryID: [hit.__queryID],\r",
    "\tobjectIDs: [hit.objectID],\r",
    "\tpositions: [hit.__position],\r",
    "})\r",
    "\r",
    "aa('convertedObjectIDsAfterSearch', {\r",
    "\teventName: \"Add to cart\",\r",
    "\tindex: \"...\", // infered\r",
    "\tqueryID: [hit.__queryID],\r",
    "\tobjectIDs: [hit.objectID],\r",
    "})\r",
    "```\r",
    "\r",
