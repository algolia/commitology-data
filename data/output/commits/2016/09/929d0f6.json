  "hash": "929d0f6",
  "author": "Alex S",
  "subject": "feat(highlight): provide a function to use highligth in react (algolia/react-instantsearch#1346)",
  "bodyLines": [
    "Usage in a custom hits widget:\r",
    "\r",
    "```javascript\r",
    "const ProductHits = Hits.connect(({hits}) => {\r",
    "  const hitComponents = hits.map( hit =>\r",
    "    <div key={hit.objectID}>\r",
    "      <span className=\"hit-name\">{hightlight('name', hit)}</span>\r",
    "    </div>\r",
    "  );\r",
    "\r",
    "  return <div className=\"hits\">{hitComponents}</div>;\r",
    "});\r",
    "```"
  ],
  "date": 1475067506
}
