    "Co-authored-by: Clément Vannicatte <20689156+shortcuts@users.noreply.github.com>\r",
    "\r",
    "* use newest helper\r",
    "\r",
    "* fix eslint\r",
    "\r",
    "* simplify\r",
    "\r",
    "* remove unused $$params\r",
    "\r",
    "* extract payload recursively & safer\r",
    "\r",
    "* fix(index): add official widget disclaimer\r",
    "\r",
    "* chore: consistent import\r",
    "\r",
    "* test(telemetry): add unitary test\r",
    "\r",
    "* rename officialWidget to official\r",
    "\r",
    "* remove $$official (for $$widgetType in separate PR)\r",
