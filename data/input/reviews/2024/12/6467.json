    "author_association": "MEMBER",
    "body": "`useMemo()` prevents the value from being true during a rerender triggered by a wrapping component.\r\n\r\nBecause of strict mode, the initial results are cleaned during the automatic unmount/remount, which will cause the issue the previous PR aimed to fix.",
    "commit_id": "0772c03d1a5a9382e5678075cb7c75977e0f78df",
    "created_at": "2024-12-10T13:00:06Z",
    "diff_hunk": "@@ -51,11 +48,17 @@ export function InstantSearchNext<\n }: InstantSearchNextProps<TUiState, TRouteState>) {\n   const isMounting = useRef(true);\n   const isServer = typeof window === 'undefined';\n-  const pathname = usePathname();\n-  const hasRouteChanged =\n-    !isServer &&\n-    window[InstantSearchLastPath] &&\n-    window[InstantSearchLastPath] !== pathname;\n+\n+  const hasRouteChanged = useMemo(() => {\n+    // On server, always return false\n+    if (isServer) {\n+      return false;\n+    }\n+\n+    // On client, route has changed if initialResults have been cleaned up\n+    const hasInitialResults = window[InstantSearchInitialResults] !== undefined;\n+    return !hasInitialResults;\n+  }, [isServer]);",
