    "author_association": "CONTRIBUTOR",
    "body": "This test runs locally, but [fails in CI](https://app.circleci.com/pipelines/github/algolia/instantsearch/11204/workflows/fa6f843a-c2a3-4823-8645-738773317cd0/jobs/54863) - so I'm assuming there is some difference between vue2 and vue3 that isn't accounted for. I added it as almost an afterthought. Since the common tests succeed we could remove this unless there is a straight-forward approach to ensuring it runs for vue3 as well.",
    "commit_id": "940b40e9dec4cf7c057001de801ff00b2d3a572d",
    "created_at": "2024-07-12T18:26:05Z",
    "diff_hunk": "@@ -28,6 +42,37 @@ it('accepts an escapeHTML prop', () => {\n   expect(wrapper.vm.widgetParams.escapeHTML).toBe(true);\n });\n \n+it('exposes banner prop to the banner slot', () => {\n+  __setState({\n+    ...defaultState,\n+    banner: {\n+      image: {\n+        urls: [{ url: 'https://via.placeholder.com/550x250' }],\n+      },\n+    },\n+  });\n+\n+  const wrapper = mount(\n+    {\n+      components: { Hits },\n+      template: `\n+      <Hits>\n+        <template v-slot:banner=\"{ banner }\">\n+          <img :src=banner.image.urls[0].url />\n+        </template>\n+      </Hits>\n+    `,\n+    },\n+    {\n+      propsData: {\n+        showBanner: true,\n+      },\n+    }\n+  );\n+  const img = wrapper.find('img');\n+  expect(img.attributes('src')).toBe('https://via.placeholder.com/550x250');\n+});\n+",
