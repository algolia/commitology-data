    "author_association": "CONTRIBUTOR",
    "body": "As we discussed via DM, here's the proposed git diff:\r\n\r\n```diff\r\ndiff --git a/packages/react-instantsearch/src/components/StarRating.js b/packages/react-instantsearch/src/components/StarRating.js\r\nindex abcec5e..486e6b3 100644\r\n--- a/packages/react-instantsearch/src/components/StarRating.js\r\n+++ b/packages/react-instantsearch/src/components/StarRating.js\r\n@@ -31,9 +31,10 @@ class StarRating extends Component {\r\n     }\r\n   }\r\n \r\n-  buildItem({max, lowerBound, count, translate, createURL, isLowest}) {\r\n+  buildItem({max, lowerBound, count, translate, createURL}) {\r\n     const selected = lowerBound === this.props.currentRefinement.min &&\r\n       max === this.props.currentRefinement.max;\r\n+    const isLowestAndSelected = lowerBound === this.props.min && selected;\r\n     const disabled = !count;\r\n \r\n     const icons = [];\r\n@@ -49,58 +50,36 @@ class StarRating extends Component {\r\n         )}\r\n         />);\r\n     }\r\n-    if (isLowest && selected) {\r\n-      return (\r\n-        <div {...cx(\r\n-          'ratingLink',\r\n-          'ratingLinkSelected',\r\n-          disabled && 'ratingLinkDisabled')}\r\n-           disabled={disabled}\r\n-           key={lowerBound}\r\n-        >\r\n-          {icons}\r\n-          <span {...cx(\r\n-            'ratingLabel',\r\n-            'ratingLabelSelected',\r\n-            disabled && 'ratingLabelDisabled')}>\r\n-            {translate('ratingLabel')}\r\n-            </span>\r\n-          <span> </span>\r\n-          <span {...cx(\r\n-            'ratingCount',\r\n-            'ratingCountSelected',\r\n-            disabled && 'ratingCountDisabled')}>\r\n-            {count}\r\n-          </span>\r\n-        </div>\r\n-      );\r\n-    }\r\n-    return (\r\n-      <a {...cx(\r\n-        'ratingLink',\r\n-        selected && 'ratingLinkSelected',\r\n-        disabled && 'ratingLinkDisabled')}\r\n-         disabled={disabled}\r\n-         key={lowerBound}\r\n-         onClick={this.onClick.bind(this, lowerBound, max)}\r\n-         href={createURL({lowerBound, max})}\r\n-      >\r\n-        {icons}\r\n-        <span {...cx(\r\n-          'ratingLabel',\r\n-          selected && 'ratingLabelSelected',\r\n-          disabled && 'ratingLabelDisabled')}>\r\n-          {translate('ratingLabel')}\r\n-          </span>\r\n-        <span> </span>\r\n-        <span {...cx(\r\n-          'ratingCount',\r\n-          selected && 'ratingCountSelected',\r\n-          disabled && 'ratingCountDisabled')}>\r\n-          {count}\r\n+\r\n+    const Wrapper = isLowestAndSelected ? 'div' : 'a';\r\n+    const clickProps = isLowestAndSelected ? {} : {\r\n+      onClick: this.onClick.bind(this, lowerBound, max),\r\n+      href: createURL({lowerBound, max}),\r\n+    };\r\n+\r\n+    return <Wrapper {...cx(\r\n+      'ratingLink',\r\n+      selected && 'ratingLinkSelected',\r\n+      disabled && 'ratingLinkDisabled')}\r\n+      disabled={disabled}\r\n+      key={lowerBound}\r\n+      {...clickProps}\r\n+    >\r\n+      {icons}\r\n+      <span {...cx(\r\n+        'ratingLabel',\r\n+        selected && 'ratingLabelSelected',\r\n+        disabled && 'ratingLabelDisabled')}>\r\n+        {translate('ratingLabel')}\r\n         </span>\r\n-      </a>\r\n-    );\r\n+      <span> </span>\r\n+      <span {...cx(\r\n+        'ratingCount',\r\n+        selected && 'ratingCountSelected',\r\n+        disabled && 'ratingCountDisabled')}>\r\n+        {count}\r\n+      </span>\r\n+    </Wrapper>;\r\n   }\r\n```",
