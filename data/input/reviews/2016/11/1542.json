    "author_association": "CONTRIBUTOR",
    "body": "Maybe we could name it `this.state.searchState`?\n",
    "commit_id": "a4206f59b873f7c4cc84ab11bebaba3271b96d69",
    "created_at": "2016-11-14T14:36:46Z",
    "diff_hunk": "@@ -0,0 +1,32 @@\n+import React, {Component} from 'react';\n+import qs from 'qs';\n+\n+export const withUrlSync = App => class extends Component {\n+  constructor() {\n+    super();\n+    const history = window.history;\n+    this.state = {history, state: {...qs.parse(window.location.search.slice(1))}};\n+  }\n+\n+  onStateChange = nextState => {\n+    const THRESHOLD = 700;\n+    const newPush = Date.now();\n+    this.setState({lastPush: newPush, state: nextState});\n+    const location = window.location;\n+    const search = nextState ? `?${qs.stringify({...qs.parse(location.search.slice(1)), ...nextState})}` : '';\n+    if (this.state.lastPush && newPush - this.state.lastPush <= THRESHOLD) {\n+      this.state.history.replaceState(null, null, search);\n+    } else {\n+      this.state.history.pushState(null, null, search);\n+    }\n+  };\n+\n+  createURL = state => `?${qs.stringify(state)}`;\n+\n+  render() {\n+    return <App {...this.props}\n+                state={this.state.state}",
