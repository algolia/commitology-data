# Anthropic API Key for Claude sentiment analysis
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Personal Access Token for fetching repository data
# Get your token from: https://github.com/settings/tokens
GITHUB_TOKEN_COMMITOLOGY_DATA=

# Algolia credentials for indexing
# Get your credentials from: https://www.algolia.com/account/api-keys/
ALGOLIA_APP_ID=
ALGOLIA_INDEX_NAME=
ALGOLIA_ADMIN_API_KEY=
